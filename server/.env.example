# Copy to .env and fill in real values. Never commit .env.
# Every variable below must also be set in each deployment environment
# (Vercel: Project Settings > Environment Variables, for Production and Preview).

# ── Required ──────────────────────────────────────────────────────────────────
# Include the database name in the path, otherwise the driver falls back to "test".
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/bm-promo

# Admin credentials. ADMIN_ID / ADMIN_PASS are the legacy names and still work.
ADMIN_EMAIL=admin@buddingmariners.com
ADMIN_PASSWORD=change-me

# Signs admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, the server generates a random secret per process, which ends every
# admin session on restart. Set this in every deployment environment.
ADMIN_TOKEN_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Browser origins allowed to call this API. Comma or newline separated, no
# trailing slash, scheme included. When set, this replaces the built-in defaults,
# so list every origin the API must serve.
ALLOWED_ORIGINS=https://www.buddingmariners.com,https://buddingmariners.com,http://localhost:5173,http://localhost:3000

# Wildcard origins, for hosts whose name is not known ahead of time such as
# per-deployment preview URLs. `*` matches a single hostname label.
ALLOWED_ORIGIN_PATTERNS=https://*.vercel.app

# ── Optional ──────────────────────────────────────────────────────────────────
PORT=5000

# Verify-only secret used during rotation, so sessions signed with the old
# secret keep working until they expire. Remove once rotation is complete.
ADMIN_TOKEN_SECRET_PREVIOUS=

# Max JSON request body. Rich blog content needs more than Express's 100kb default.
JSON_BODY_LIMIT=5mb

# debug | info | warn | error. Defaults to debug locally and info in production.
LOG_LEVEL=

# Database timeouts. Keep the server selection timeout below the platform's
# function timeout so an outage returns 503 instead of a killed invocation.
DB_SERVER_SELECTION_TIMEOUT_MS=8000
DB_SOCKET_TIMEOUT_MS=20000
DB_MAX_POOL_SIZE=10

# ── Cloudinary (media library and uploads) ────────────────────────────────────
# From the Cloudinary console under Settings > API Keys.
# All three are required; if any is missing, upload endpoints return 503.
# CLOUDINARY_API_SECRET must never reach the client bundle.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
