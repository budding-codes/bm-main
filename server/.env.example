# Copy to .env and fill in real values. Never commit .env.

# ── Required ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/bm-promo

# Admin credentials. ADMIN_ID / ADMIN_PASS are the legacy names and still work.
ADMIN_EMAIL=admin@buddingmariners.com
ADMIN_PASSWORD=change-me

# Signs admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, the server generates a random secret per process, which ends every
# admin session on restart. Set this in every deployment environment.
ADMIN_TOKEN_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
PORT=5000

# Comma-separated. Defaults to the production domains plus localhost:5173.
ALLOWED_ORIGINS=

# Verify-only secret used during rotation, so sessions signed with the old
# secret keep working until they expire. Remove once rotation is complete.
ADMIN_TOKEN_SECRET_PREVIOUS=

# Max JSON request body. Rich blog content needs more than Express's 100kb default.
JSON_BODY_LIMIT=5mb

# ── Cloudinary (media library and uploads) ────────────────────────────────────
# From the Cloudinary console under Settings > API Keys.
# CLOUDINARY_API_SECRET must never reach the client bundle.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
