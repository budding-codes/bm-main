# Copy to .env.local for local overrides. Vite only exposes VITE_-prefixed
# variables to the bundle, and it inlines them at build time — a change here
# requires a rebuild, not just a restart.

# Absolute base URL of the API, no trailing slash.
#
# Leave empty for local development: requests stay relative and the Vite dev
# server proxies /api to http://localhost:5000 (see vite.config.ts), which keeps
# development same-origin.
#
# Required in production. Set it in the hosting provider's environment settings
# for the Production and Preview environments:
#   VITE_API_BASE_URL=https://bm-promo.vercel.app
VITE_API_BASE_URL=

# The production frontend rewrites /sitemap.xml to the API host above
# (see vercel.json). Keep that destination in sync if the API domain changes.
